# Executor service Dockerfile (policy runner)
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code into a package directory named rltrader
COPY . ./rltrader
COPY models ./models

# Run executor (requires MODEL_PATH env var)
# docker run ... -e MODEL_PATH=/app/models/ppo_final_BTCUSDT
CMD ["python", "-c", "import sys, asyncio; from rltrader.execution.runner import PolicyRunner; asyncio.run(PolicyRunner(sys.argv[1]).run())", "${MODEL_PATH}"]
