# .env file template - copy to .env and fill in your credentials
# DO NOT commit this file to version control

# Database
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=rltrader
DB_HOST=timescaledb
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Binance Futures (Testnet)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_grafana_password_here

# Model path for executor
MODEL_PATH=/app/models/ppo_final_BTCUSDT
